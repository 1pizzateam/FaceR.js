{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "sourceMap": false,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowSyntheticDefaultImports": true,
    "preserveConstEnums": true,
    "allowJs": false,
    "skipLibCheck": true,
    "removeComments": true,
    "declaration": true,
    "outDir": "build/es6/",
    "rootDir": "src/"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "tools",
    "heads",
    "build",
    "**/*.test.ts"
  ]
}
